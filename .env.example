# ── Required ──────────────────────────────────────────────
XAI_API_KEY=xai-...

# ── Mode ──────────────────────────────────────────────────
# development | production
NODE_ENV=development
PORT=8787

# ── Models (per agent role) ───────────────────────────────
# dev default: cheap expanders, strong orchestrator/scorer.
MODEL_ORCHESTRATOR=grok-4.6
MODEL_EXPANDER=grok-4.5
MODEL_RESEARCHER=grok-4.6
MODEL_CRITIC=grok-4.6
MODEL_SCORER=grok-4.6

# ── Loop limits ───────────────────────────────────────────
MAX_NODES=200
MAX_DEPTH=6
MAX_CONCURRENCY=3
MAX_CHILDREN_PER_DECISION=4
BUDGET_USD=2
# Cap on the share of the budget that live research may consume.
RESEARCH_BUDGET_FRACTION=0.4

# ── Persistence ───────────────────────────────────────────
DATA_DIR=./data

# ── Replay recorded LLM responses from the op-log; no API calls (dev only)
MOCK_LLM=0

# ── Prod: bearer token required on mutation routes (leave empty to disable)
ADMIN_TOKEN=
